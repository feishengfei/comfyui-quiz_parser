<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<style>
@page {
    size: A4;
    margin: 15mm;
}
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    font-family: "Noto Sans SC", system-ui, sans-serif;
    font-size: 10pt;
    line-height: 1.6;
    color: #111;
}
.quiz-header {
    text-align: center;
    margin-bottom: 18pt;
}
.quiz-title {
    font-size: 16pt;
    font-weight: bold;
    margin-bottom: 8pt;
}
.quiz-desc {
    font-size: 9pt;
    color:#333;
}
.group-block {
    margin-bottom: 22pt;
}
.group-title {
    font-size:16pt;
    font-weight:bold;
    margin-bottom:10pt;
    border-bottom:1px solid #aaa;
    padding-bottom:4pt;
}
/* ========== gst 共享篇章打印样式 ========== */
.group-shared-text {
    margin: 8pt 0 12pt 0;
    line-height: 1.7;
    white-space: pre-line;
}
/* ========================================== */
.question-wrap {
    margin-bottom:16pt;
    padding-bottom:8pt;
}
.q-label-row {
    display:flex;
    gap:12pt;
    align-items:center;
    margin-bottom:6pt;
}
.q-label {
    font-weight:bold;
}
.q-answer-tag {
    color:#197528;
    font-weight:bold;
}
.q-stem {
    margin-bottom:8pt;
}
.q-img {
    max-width:100%;
    max-height: 3cm;
    margin:1pt 0;
}
.options-list {
    list-style: none;
    padding-left: 0pt;
    display: flex;
    flex-direction: row;
    gap: 22pt;
    flex-wrap: wrap;
    margin: 6pt 0 8pt 0;
}
.options-list li {
    /* 不强制固定宽度；空间不足自动换行，允许长短不一样 */
    flex: 0 1 auto;
}
.q-explanation {
    margin-top:8pt;
    padding-left:12pt;
    border-left:3px solid #777;
    color:#333;
    font-size:12pt;
}
/* 分页辅助：避免题目中间被切断 */
.question-wrap, .group-block {
    page-break-inside:avoid;
}
</style>
</head>
<body>
<div class="quiz‑header">
    <h1 class="quiz‑title">{{ quiz.quiz_meta.title }}【教师版】</h1>
    {% if quiz.quiz_meta.subject %}
    <div class="quiz‑desc">{{ quiz.quiz_meta.subject }}</div>
    {% endif %}
</div>
{% for g in quiz.groups %}
<div class="group‑block">
    <div class="group‑title">{{ g.gt }}</div>
    {% if g.gst %}
    <div class="group-shared-text">
{{ g.gst | e }}
    </div>
    {% endif %}
    {# group顶层图片 #}
    {% if g._image_logic_paths %}
        {% for sp in g._image_logic_paths %}
            <img class="q‑img" src="{{ img_map[sp] }}" />
        {% endfor %}
    {% endif %}
    {% for q in g.questions %}
    <div class="question‑wrap">
        <div class="q‑label‑row">
            <div class="q‑label"><b>{{ loop.index }}：</b></div>
            {% if q.ka %}
            <div class="q‑answer‑tag">正确答案：{{ q.ka }}</div>
            {% endif %}
        </div>
        <div class="q‑stem"><b>{{ q.stem }} </b></div>
        {# 题目图片，从回填的路径列表读取 #}
        {% if q._image_logic_paths %}
            {% for sp in q._image_logic_paths %}
                <img class="q‑img" src="{{ img_map[sp] }}" />
            {% endfor %}
        {% endif %}
        {% if q.o %}
        <ul class="options‑list">
            {% for opt in q.o %}
            <li>{{ opt.k }}. {{ opt.t }}</li>
            {% endfor %}
        </ul>
        {% endif %}
        {% if q.e %}
        <div class="q‑explanation">解析：{{ q.e }}</div>
        {% endif %}
    </div>
    {% endfor %}
</div>
{% endfor %}
</body>
</html>
