<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<style>
@page {
    size: A4;
    margin: 15mm;
}
* {
    box-sizing: border-box;
    margin:0;
    padding:0;
}
body {
    font-family: "Noto Sans SC", system-ui, sans-serif;
    font-size:14pt;
    line-height:1.6;
}
.quiz-header{
    text-align:center;
    margin-bottom:18pt;
}
.quiz-title{
    font-size:20pt;
    font-weight:bold;
    margin-bottom:8pt;
}
.quiz-desc{
    font-size:13pt;
    color:#444;
}
.info-row{
    display:flex;
    gap:40pt;
    justify-content:center;
    margin-bottom:16pt;
}
.group-block{
    margin-bottom:22pt;
}
.group-title{
    font-size:16pt;
    font-weight:bold;
    margin-bottom:10pt;
    border-bottom:1px solid #aaa;
    padding-bottom:4pt;
}
/* ========== gst 共享篇章打印样式 ========== */
.group-shared-text {
    margin: 8pt 0 12pt 0;
    line-height: 1.7;
    white-space: pre-line;
}
/* ========================================== */
.question-wrap{
    margin-bottom:16pt;
}
.q-img{
    max-width:100%;
    max-height:16cm;
    margin:8pt 0;
}
.options-list{
    list-style-type:upper-alpha;
    padding-left:24pt;
}
.options-list li{
    margin-bottom:4pt;
}
.question-wrap, .group-block {
    page-break-inside: avoid;
}
</style>
</head>
<body>
<div class="quiz-header">
    <h1 class="quiz-title">{{ quiz.quiz_meta.title }}</h1>
    {% if quiz.quiz_meta.subject %}
    <div class="quiz-desc">{{ quiz.quiz_meta.subject }}</div>
    {% endif %}
</div>
<div class="info-row">
    <span>姓名：____________</span>
    <span>班级：____________</span>
</div>
{% for g in quiz.groups %}
<div class="group-block">
    <div class="group-title">{{ g.gt }}</div>
    {% if g.gst %}
    <div class="group-shared-text">
{{ g.gst | e }}
    </div>
    {% endif %}
    {% if g._image_logic_paths %}
        {% for sp in g._image_logic_paths %}
            <img class="q-img" src="{{ img_map[sp] }}" />
        {% endfor %}
    {% endif %}
    {% for q in g.questions %}
    <div class="question-wrap">
        <div><b>题目 {{ loop.index }}：{{ q.stem }} </b></div>
        {% if q._image_logic_paths %}
            {% for sp in q._image_logic_paths %}
                <img class="q-img" src="{{ img_map[sp] }}" />
            {% endfor %}
        {% endif %}
        {% if q.o %}
        <ul class="options-list">
            {% for opt in q.o %}
            <li>{{ opt.t }}</li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
    {% endfor %}
</div>
{% endfor %}
</body>
</html>
