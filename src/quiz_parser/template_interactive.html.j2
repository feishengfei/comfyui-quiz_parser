<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    font-family: "Noto Sans SC", system-ui, sans-serif;
    background-color: #020617;
    color: #c7d1dd;
    padding: 24px 16px;
}
#score-stats-container {
    position: sticky;
    top: 0;
    background-color: #0f172a;
    padding: 12px 16px;
    display: flex;
    gap: 24px;
    z-index: 10;
    border-radius: 8px;
    margin-bottom: 24px;
}
.quiz-meta {
    text-align: center;
    margin-bottom: 28px;
}
.quiz-meta h1 {
    font-size: 26px;
    margin-bottom: 8px;
}
.group-title {
    font-size: 18px;
    font-weight: bold;
    margin-top: 24px;
    margin-bottom:12px;
    padding-bottom:4px;
    border-bottom: 1px solid #475569;
}
/* ========== 新增 gst 共享篇章样式 ========== */
.group-shared-text {
    margin: 0.8em 0 1.2em 0;
    line-height: 1.7;
    font-size: 1rem;
    white-space: pre-line;
}
.group-block {
    margin-bottom: 20px;
}
/* ========================================== */
.question-container {
    background-color: #0f172a;
    border-radius:8px;
    padding:16px;
    margin-bottom:16px;
}
.q-header-row {
    display:flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom:8px;
}
.q-label {
    font-weight:bold;
    font-size:16px;
}
.btn-explain {
    background:transparent;
    border:none;
    color:#34d399;
    cursor:pointer;
    font-size:14px;
}
.q-stem {
    margin-bottom:10px;
    line-height:1.55;
}
.q-img {
    max-width:100%;
    margin:10px 0;
    border-radius:4px;
}
.audio-wrap {
    margin:8px 0 12px 0;
}
audio {
    width:100%;
}
.options-wrap {
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-bottom:12px;
}
.opt-row {
    display:flex;
    gap:10px;
    align-items:center;
    padding:6px 8px;
    border-radius:4px;
}
input[type="radio"] {
    width:18px;
    height:18px;
    cursor:pointer;
}
.input-fill-box {
    width:100%;
    padding:8px 10px;
    font-size:16px;
    border-radius:4px;
    border:1px solid #475569;
    background:#1e293b;
    color:#e2e8f0;
}
.correct-mark {
    border:2px solid #10b981;
}
.wrong-mark {
    border:2px solid #ef4444;
}
dialog {
    border-radius:8px;
    background-color:#0f172a;
    color:#e2e8f0;
    border:1px solid #475569;
    padding:16px;
    max-width:90vw;
    max-height:80vh;
    margin: auto;  /* showModal时自动屏幕居中 */
}
dialog::backdrop {
    background-color:rgba(0,0,0,0.65);
}
#modal-text {
    overflow-y: auto;
    max-height: calc(80vh - 60px);
    line-height:1.6;
}
.btn-close-modal {
    float:right;
    background-color:#ef4444;
    color:white;
    border:none;
    padding:4px 8px;
    border-radius:4px;
    cursor:pointer;
    margin-bottom:12px;
}
</style>
</head>
<body onload="main()">
<div class="quiz-meta">
    <h1>{{ quiz.quiz_meta.title }}</h1>
    {% if quiz.quiz_meta.subject %}
    <div>{{ quiz.quiz_meta.subject }}</div>
    {% endif %}
</div>
<div id="score-stats-container">
    <div>得分: <span id="score">0</span>%</div>
    <div>正确: <span id="cnt-ok">0</span></div>
    <div>错误: <span id="cnt-err">0</span></div>
</div>
<div id="quiz-root"></div>
<dialog id="modal">
    <button class="btn-close-modal" onclick="modal.close()">关闭</button>
    <div class="modal-content" id="modal-text"></div>
</dialog>
<script>
const quizRawData = {{ quiz | tojson | safe }};
const imgMap = {{ img_map | tojson | safe }};
const audioMap = {{ audio_map | tojson | safe }};
const shuffleFlag = {{ shuffle | lower | safe }};
let correctSet = new Set();
let wrongSet = new Set();
let questionList = [];

// 返回带group完整信息的结构，不再扁平化丢弃group
function buildGroupWrapper(rawQuiz){
    const groupsWrap = [];
    for(const g of rawQuiz.groups){
        const qs = [];
        for(const q of g.questions){
            qs.push({
                groupTitle: g.gt,
                groupAudioKey: g._audio_logic_path ?? null,
                groupImagePaths: g._image_logic_paths ?? [],
                groupGst: g.gst ?? null,
                question: q
            })
        }
        groupsWrap.push({
            group: g,
            questionWrappers: qs
        })
    }
    return groupsWrap;
}

function shuffleArray(arr){
    const copy = [...arr];
    for(let i = copy.length - 1; i > 0; i--){
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
}

function updateScore(){
    const total = questionList.length;
    const ok = correctSet.size;
    const err = wrongSet.size;
    const pct = total>0 ? Math.round((ok/total)*100):0;
    document.getElementById("score").textContent = pct;
    document.getElementById("cnt-ok").textContent = ok;
    document.getElementById("cnt-err").textContent = err;
}

// 渲染单个小题：只渲染【题目自身音频、题目自身图片】，group音图挪到group块渲染
function renderOneQuestion(qWrapper, qGlobalIdx){
    const div = document.createElement("div");
    div.className = "question-container";
    div.dataset.qid = String(qGlobalIdx);
    const q = qWrapper.question;
    const qType = q.type ?? "single";

    let audioHtml = "";
    // 仅渲染小题自身音频，group共享音频在group块统一渲染
    if(q._audio_logic_path && audioMap[q._audio_logic_path]){
        audioHtml += `<div class="audio-wrap"><audio controls src="${audioMap[q._audio_logic_path]}"></div>`;
    }
    let imgHtml = "";
    // 仅渲染小题自身图片，group共享图片在group块统一渲染
    const qImgPaths = q._image_logic_paths ?? [];
    for(const sp of qImgPaths){
        if(imgMap[sp]){
            imgHtml += `<img class="q-img" src="${imgMap[sp]}">`;
        }
    }

    let optHtml = "";
    if(qType === "single" || qType === "cloze"){
        // 原有单选逻辑
        const alpha = ["A","B","C","D","E","F"];
        q.o.forEach((opt, oIdx)=>{
            optHtml += `
            <div class="opt-row" data-opt-key="${opt.k}" data-qid="${qGlobalIdx}">
                <input type="radio" name="q_${qGlobalIdx}" id="opt_${qGlobalIdx}_${oIdx}" value="${opt.k}">
                <label for="opt_${qGlobalIdx}_${oIdx}">${opt.t}</label>
            </div>`
        })
    }else if(qType === "tf"){
        // 判断正误 T / F
        optHtml += `
        <div class="opt-row" data-opt-key="true" data-qid="${qGlobalIdx}">
            <input type="radio" name="q_${qGlobalIdx}" id="opt_${qGlobalIdx}_t" value="true">
            <label for="opt_${qGlobalIdx}_t">T (正确)</label>
        </div>
        <div class="opt-row" data-opt-key="false" data-qid="${qGlobalIdx}">
            <input type="radio" name="q_${qGlobalIdx}" id="opt_${qGlobalIdx}_f" value="false">
            <label for="opt_${qGlobalIdx}_f">F (错误)</label>
        </div>`;
    }else if(qType === "fill"){
        // 文本填空输入框
        optHtml += `
        <div class="options-wrap">
            <input class="input-fill-box" data-qid="${qGlobalIdx}" type="text" placeholder="请在此填写答案">
        </div>`;
    }

    div.innerHTML = `
        <div class="q-header-row">
            <div class="q-label">题目 ${qGlobalIdx+1}</div>
            <button class="btn-explain" data-qidx="${qGlobalIdx}">查看解析</button>
        </div>
        <div class="q-stem">${q.stem ?? ""}</div>
        ${audioHtml}
        ${imgHtml}
        <div class="options-wrap">${optHtml}</div>
    `;
    return div;
}

function bindEvents(){
    // 解析弹窗
    document.querySelectorAll(".btn-explain").forEach(btn=>{
        btn.onclick = (ev)=>{
            const qIdx = Number(ev.target.dataset.qidx);
            const modal = document.getElementById("modal");
            const modalText = document.getElementById("modal-text");
            const qObj = questionList[qIdx].question;
            modalText.innerText = qObj.e ?? "暂无解析";
            modal.showModal();
        }
    })

    // radio单选事件（single/cloze / tf）
    document.querySelectorAll(".opt-row input[type='radio']").forEach(radio=>{
        radio.onchange = (ev)=>{
            const inp = ev.target;
            const qid = inp.closest(".opt-row").dataset.qid;
            const idx = Number(qid);
            if (!Number.isInteger(idx) || idx < 0 || idx >= questionList.length) return;
            const targetQ = questionList[idx].question;
            let isOk = false;
            if(targetQ.type === "tf"){
                const userVal = inp.value === "true";
                isOk = (userVal === targetQ.tf_correct);
            }else{
                isOk = (inp.value === targetQ.ka);
            }
            document.querySelectorAll(`.opt-row[data-qid="${qid}"]`).forEach(r=>{
                r.classList.remove("correct-mark","wrong-mark");
            })
            if(isOk){
                correctSet.add(String(qid));
                wrongSet.delete(String(qid));
                inp.closest(".opt-row").classList.add("correct-mark");
            }else{
                wrongSet.add(String(qid));
                correctSet.delete(String(qid));
                inp.closest(".opt-row").classList.add("wrong-mark");
            }
            updateScore();
        }
    })

    // fill填空输入框失去焦点判分（简易：trim+小写比对）
    document.querySelectorAll(".input-fill-box").forEach(input=>{
        input.onblur = (ev)=>{
            const idx = Number(ev.target.dataset.qid);
            if (!Number.isInteger(idx) || idx < 0 || idx >= questionList.length) return;
            const targetQ = questionList[idx].question;
            if(targetQ.type !== "fill") return;
            const userAns = ev.target.value.trim().toLowerCase();
            const acceptSet = new Set(targetQ.fill_keys.map(s=>s.trim().toLowerCase()));
            if(acceptSet.has(userAns)){
                correctSet.add(String(idx));
                wrongSet.delete(String(idx));
                ev.target.style.borderColor="#10b981";
            }else{
                wrongSet.add(String(idx));
                correctSet.delete(String(idx));
                ev.target.style.borderColor="#ef4444";
            }
            updateScore();
        }
    })
}

function main(){
    const modal = document.getElementById("modal");
    modal.addEventListener('click', (e)=>{
        if(e.target === modal){
            modal.close();
        }
    });
    console.log("=== DEBUG ===");
    console.log("imgMap keys", Object.keys(imgMap));
    console.log("quizRawData groups", quizRawData.groups);
    const groupWrappers = buildGroupWrapper(quizRawData);
    let allQWrapper = [];
    for(const gw of groupWrappers){
        allQWrapper.push(...gw.questionWrappers);
    }
    if(shuffleFlag){
        allQWrapper = shuffleArray(allQWrapper);
    }
    questionList = allQWrapper;
    const root = document.getElementById("quiz-root");
    root.innerHTML = "";
    let globalQIdx = 0;
    for(const gw of groupWrappers){
        const gBlock = document.createElement("div");
        gBlock.className = "group-block";
        // group大题标题
        const gTitleEl = document.createElement("div");
        gTitleEl.className = "group-title";
        gTitleEl.textContent = gw.group.gt;
        gBlock.appendChild(gTitleEl);
        // 渲染 group.gst 共享篇章文本
        if(gw.group.gst){
            const gstEl = document.createElement("div");
            gstEl.className = "group-shared-text";
            gstEl.textContent = gw.group.gst;
            gBlock.appendChild(gstEl);
        }
        // 【组级别：共享图片，仅渲染一次】
        const groupImgPaths = gw.group._image_logic_paths ?? [];
        for(const sp of groupImgPaths){
            if(imgMap[sp]){
                const imgEl = document.createElement("img");
                imgEl.className = "q-img";
                imgEl.src = imgMap[sp];
                gBlock.appendChild(imgEl);
            }
        }
        // 【组级别：共享音频，仅渲染一次】
        if(gw.group._audio_logic_path && audioMap[gw.group._audio_logic_path]){
            const audioWrap = document.createElement("div");
            audioWrap.className = "audio-wrap";
            audioWrap.innerHTML = `<audio controls src="${audioMap[gw.group._audio_logic_path]}">`;
            gBlock.appendChild(audioWrap);
        }
        // 渲染本组全部小题
        for(const qWrap of gw.questionWrappers){
            const realIdx = questionList.indexOf(qWrap);
            const qDom = renderOneQuestion(qWrap, realIdx);
            gBlock.appendChild(qDom);
            globalQIdx +=1;
        }
        root.appendChild(gBlock);
    }
    bindEvents();
    updateScore();
}
</script>
</body>
</html>
